# Server Configuration
PORT=3001

# Moco API Configuration
# Your Moco subdomain (e.g., if you log in at "agency.mocoapp.com", use "agency")
MOCO_DOMAIN=your-subdomain-here
MOCO_API_KEY=your-moco-api-key-here

# Timing App API Configuration
# Generate this in the Timing Web App (Integrations -> API)
TIMING_API_KEY=your-timing-api-key-here
